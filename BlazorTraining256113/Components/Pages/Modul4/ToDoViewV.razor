@page "/todoV"
@inject ToDoVM vm
<div class="container">
    <div class="row">
        <ul class="list-group">
            <li class="list-group-item active">Todo</li>
            @if (isLoading)
            {
                <li class="list-group-item">Daten laden...</li>
            }
            else
            {
                <Virtualize Items="@vm.Liste" Context="item" OverscanCount="5" ItemSize="30">
                    <EmptyContent>
                        <li>keine Daten</li>
                    </EmptyContent>
                    <ItemContent>
                        <li class='list-group-item list-group-item-action
                            @item.completed?"list-group-item-dark":"" '>
                            @item.todo
                        </li>
                    </ItemContent>
                </Virtualize>
            }
        </ul>
    </div>
</div>

@code {
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await vm.LoadTodosAsync();
        isLoading = false;
    }
}
