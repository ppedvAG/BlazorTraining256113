@page "/kunden"
@using BlazorTraining256113.Models


@inject NorthwindContext vm
<div class="container">
    <div class="row">
        <div class="input-group mb-3">
            <input type="text" class="form-control" placeholder="suche" @bind="Eingabe">
            <button class="btn btn-outline-secondary" type="button">
                <i class="bi bi-search"></i> search
            </button>
        </div>
    </div>
    <div class="row">
        <ul class="list-group">
            <li class="list-group-item active">Todo</li>
            @if (vm.Customers == null)
            {
                <li>Daten laden...</li>
            }
            else
            {
                @foreach (var item in vm.Customers.Where(x => x.CompanyName.Contains(Eingabe)))
                {


                    <li class='list-group-item '>
                        @item.CompanyName


                    </li>
                }
            }
        </ul>



    </div>
</div>
@code {
    string Eingabe = "";

}
