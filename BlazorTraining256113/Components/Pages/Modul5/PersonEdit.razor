@page "/person/edit/{PersonId:int?}"

<h3>PersonEdit @PersonId</h3>
<EditForm EditContext="ctx" OnSubmit="save">
     <DataAnnotationsValidator></DataAnnotationsValidator>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">

            <InputTextPPEDV class="form-control" width="100px"
            style="width:100px;"
            @bind-Value="VM.Name"></InputTextPPEDV>
            <ValidationMessage For="() => VM.Name" class="text-danger"></ValidationMessage>
        </div>
    </div>
    <div class="mb-3 row">
        <label  class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            
            <InputText class="form-control" @bind-Value="VM.Name"></InputText>
            <ValidationMessage For="() => VM.Name" class="text-danger"></ValidationMessage>
        </div>
    </div>
    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Grösse</label>
        <div class="col-sm-10">

            <InputNumber class="form-control" @bind-Value="VM.Gross" ></InputNumber>
            <ValidationMessage For="() => VM.Gross" class="text-danger"></ValidationMessage>
        </div>
    </div>
    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Geb. Dat</label>
        <div class="col-sm-10">

            <InputDate class="form-control" @bind-Value="VM.GebDat"></InputDate>
            <ValidationMessage For="() => VM.GebDat" class="text-danger"></ValidationMessage>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <ValidationSummary></ValidationSummary>
</EditForm>

@code {
    [Parameter]
    public int PersonId { get; set; }
    Person VM = new Person();
    EditContext ctx = new EditContext(new Person());
    void save(EditContext ctx)
    {

        if (ctx.Validate())
        {
            // save to database
        }
    }
}
