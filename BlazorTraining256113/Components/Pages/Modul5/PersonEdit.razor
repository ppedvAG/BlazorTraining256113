@page "/person/edit/{PersonId:int?}"

<h3>PersonEdit @PersonId</h3>
<EditForm Model="VM" OnSubmit="save">
     <DataAnnotationsValidator></DataAnnotationsValidator>
    <div class="mb-3 row">
        <label  class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            
            <InputText class="form-control" @bind-Value="VM.Name"></InputText>
            <ValidationMessage For="() => VM.Name" class="text-danger"></ValidationMessage>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <ValidationSummary></ValidationSummary>
</EditForm>

@code {
    [Parameter]
    public int PersonId { get; set; }
    Person VM = new Person();
